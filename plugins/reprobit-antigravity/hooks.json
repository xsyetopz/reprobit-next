{
  "reprobit-git-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/pre-tool-command.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
